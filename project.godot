; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sellaris"
run/main_scene="res://scene/MainMenue/MainUI.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MusicManager="*res://autoload/MusicManager.gd"
SettingsManager="*res://autoload/SettingsManager.gd"
SimClock="*res://autoload/SimClock.gd"
EmpireManager="*res://autoload/EmpireManager.gd"
EmpirePresetManager="*res://autoload/EmpirePresetManager.gd"
EconomyManager="*res://autoload/EconomyManager.gd"
ColonyManager="*res://autoload/ColonyManager.gd"
SpaceManager="*res://autoload/SpaceManager.gd"
ResearchManager="*res://autoload/ResearchManager.gd"

NetworkSession="*res://autoload/NetworkSession.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/mode=2

[gui]

theme/custom="res://scene/UI/theme/ObservatoryTheme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2
